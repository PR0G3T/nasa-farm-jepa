+def _open_cog(paths: list[str]) -> xr.Dataset:
+    """One GeoTIFF per variable on the same tile grid → Dataset with 2-D
+    lat/lon, so `support.sample` works unchanged. Var name = file suffix
+    (`…_LST.tif` → `LST`)."""
