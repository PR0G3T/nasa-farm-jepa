+        {"range": {"top_depth": 0, "bottom_depth": 5}, "values": {"mean": 100}},
+        {"range": {"top_depth": 5, "bottom_depth": 15}, "values": {"mean": 200}},
+        {"range": {"top_depth": 15, "bottom_depth": 30}, "values": {"mean": 400}},
